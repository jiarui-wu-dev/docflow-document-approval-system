# Copy to .env and replace every secret placeholder. Never commit .env.
# Keep values unquoted for compatibility with Spring's properties import.
POSTGRES_DB=docflow_db
POSTGRES_USER=docflow
POSTGRES_PASSWORD=replace-with-a-unique-database-password
POSTGRES_PORT=5433
APP_PORT=8080
FRONTEND_PORT=3000
SPRING_PROFILES_ACTIVE=dev

# Explicit, development-only provisioning. Existing users are NEVER modified.
DOCFLOW_DEV_USERS_ENABLED=false
DOCFLOW_ALICE_PASSWORD=replace-with-a-unique-submitter-password
DOCFLOW_BOB_PASSWORD=replace-with-a-unique-reviewer-password
DOCFLOW_ADMIN_PASSWORD=replace-with-a-unique-admin-password
